{
    "name": "strukt/queue",
    "description": "Memcached-backed FIFO message queue with replies, concurrency-safe, built on the Strukt components.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-memcached": "*",
        "strukt/base": "dev-main",
        "strukt/console": "dev-main",
        "strukt/process": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Strukt\\Queue\\Example\\": "example/src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../strukt3/base",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/base": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt3/console",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/console": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../process",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/process": "dev-main"
                }
            }
        }
    ],
    "bin": [
        "bin/kqueue"
    ],
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "find src bin tests example -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ]
}
